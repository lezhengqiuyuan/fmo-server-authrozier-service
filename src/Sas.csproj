<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>sas</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.2.2</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeContentInSingleFile>true</IncludeContentInSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Release stays symbol-free for single-file publishing; Debug keeps a
         portable PDB so coverage tooling can map lines back to source. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugType Condition="'$(Configuration)' != 'Release'">portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Chaos.NaCl.Standard" Version="1.0.0" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="builtin\roots\bg5esn.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="builtin\roles\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="builtin\roles\*.json">
      <LogicalName>builtin.roles.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Historical defaults used by AclStore to recognise "shipped, not
         customised" role files. Deliberately embedded under a different
         prefix so they are never mistaken for active templates. -->
    <EmbeddedResource Include="builtin\roles\history\*.json">
      <LogicalName>acl.history.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sas.Tests" />
  </ItemGroup>

</Project>
